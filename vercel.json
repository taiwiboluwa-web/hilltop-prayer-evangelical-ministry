{
  "framework": "vite",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|woff2?|ttf|otf|ico|png|jpe?g|webp|avif|svg))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/supabase-heartbeat",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/Adminworkspace", "destination": "/index.html" },
    { "source": "/Adminworkspace/", "destination": "/index.html" },
    { "source": "/Adminlogin", "destination": "/index.html" },
    { "source": "/Adminlogin/", "destination": "/index.html" },
    { "source": "/Admindashboard", "destination": "/index.html" },
    { "source": "/Admindashboard/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
